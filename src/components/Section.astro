---
import Container from './Container.astro'

interface Props {
  id: string
  noPaddingTop?: boolean
}

const { id, noPaddingTop = false } = Astro.props
---

<section
  id={id}
  class:list={[
    noPaddingTop ? 'pb-16' : 'py-16',
    noPaddingTop ? 'scroll-mt-[calc(var(--navbar-height)+4rem)]' : 'scroll-mt-(--navbar-height)'
  ]}
  aria-labelledby={id + '-heading'}
>
  <Container>
    <slot />
  </Container>
</section>
