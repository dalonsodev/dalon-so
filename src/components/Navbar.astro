---
import Container from './Container.astro'
---

<nav id="main-nav" class="bg-background py-4">
  <Container>
    <div class="flex items-center justify-between gap-4">
      <div>
        <!-- Hardcoded for now, will replace with actual brand logo -->
        <a href="/">Dalonso</a>
      </div>
      <ul class="flex items-center gap-4">
        <li><a href="#projects">Projects</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#stack">Stack</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
  </Container>
</nav>

<script>
  function initNavObserver(): void {
    const nav = document.getElementById('main-nav') as HTMLElement | null
    const sentinel = document.getElementById('nav-sentinel') as HTMLElement | null

    if (!nav || !sentinel) return

    const observer = new IntersectionObserver((entries: IntersectionObserverEntry[]) => {
      nav.classList.toggle('nav-scrolled', !entries[0].isIntersecting)
    })

    observer.observe(sentinel)
  }

  initNavObserver()
  document.addEventListener('astro:page-load', initNavObserver)
</script>
