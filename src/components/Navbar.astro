---
import Container from './Container.astro'

const linksBaseClass = 'text-sm text-text-secondary hover:text-text-primary transition-colors'
---

<nav id="main-nav" class="bg-background py-4">
  <Container>
    <div class="flex items-center justify-between gap-4">
      <div>
        <!-- Hardcoded for now, will replace with actual brand logo -->
        <a href="/" class="text-text-primary text-sm font-semibold">Dalonso</a>
      </div>
      <ul class="flex items-center gap-4">
        <li><a href="#projects" class={linksBaseClass}>Projects</a></li>
        <li><a href="#about" class={linksBaseClass}>About</a></li>
        <li><a href="#stack" class={linksBaseClass}>Stack</a></li>
        <li><a href="#contact" class={linksBaseClass}>Contact</a></li>
      </ul>
    </div>
  </Container>
</nav>

<script>
  function initNavObserver(): void {
    const nav = document.getElementById('main-nav') as HTMLElement | null
    const sentinel = document.getElementById('nav-sentinel') as HTMLElement | null

    if (!nav || !sentinel) return

    const observer = new IntersectionObserver((entries: IntersectionObserverEntry[]) => {
      nav.classList.toggle('nav-scrolled', !entries[0].isIntersecting)
    })

    observer.observe(sentinel)
  }

  initNavObserver()
  document.addEventListener('astro:page-load', initNavObserver)
</script>
