---
import ButtonLink from './ButtonLink.astro'
import Section from './Section.astro'
---

<Section id="contact">
  <h2 class="text-text-primary mb-8 text-2xl font-semibold" id="contact-heading">Contact</h2>
  <div class="mb-10 flex max-w-xl flex-col gap-4">
    <p class="text-text-secondary text-lg leading-relaxed">
      Open to remote contractor roles (US/EU) and in-house positions in Spain (remote or hybrid
      Madrid/Valencia/Málaga).
    </p>
    <p class="text-text-secondary text-lg leading-relaxed">Async-first. CET/UTC+1 (Spain)</p>
  </div>

  <div class="flex flex-col gap-4 sm:flex-row">
    <ButtonLink href="mailto:hello@dalon.so" variant="ghost">Email</ButtonLink>
    <ButtonLink href="https://www.linkedin.com/in/dalonsodev/" variant="ghost" target="_blank"
      >LinkedIn</ButtonLink
    >
    <ButtonLink href="https://github.com/dalonsodev" variant="ghost" target="_blank">
      GitHub
    </ButtonLink>
  </div>
</Section>
