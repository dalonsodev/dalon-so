---
import ButtonLink from './ButtonLink.astro'
import Section from './Section.astro'
---

<Section id="contact">
  <h2 class="text-text-primary mb-8 text-2xl font-semibold" id="contact-heading">Contact</h2>
  <p class="text-text-secondary mb-10 max-w-xl text-lg leading-relaxed">
    Available for remote frontend contractor roles. Open to US and Western European startups.
    Async-first. CET/UTC+2 (Spain)
  </p>
  <div class="flex flex-col gap-4 sm:flex-row">
    <ButtonLink href="mailto:hello@dalon.so" variant="ghost">Email</ButtonLink>
    <ButtonLink href="https://www.linkedin.com/in/dalonsodev/" variant="ghost" target="_blank"
      >LinkedIn</ButtonLink
    >
    <ButtonLink href="https://github.com/dalonsodev" variant="ghost" target="_blank">
      GitHub
    </ButtonLink>
  </div>
</Section>
