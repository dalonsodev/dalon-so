---
import Section from './Section.astro'
---

<Section id="stack">
  <h2 class="text-text-primary mb-8 text-2xl font-semibold" id="stack-heading">Stack</h2>
  <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 md:grid-cols-4">
    <div>
      <p class="text-text-tertiary font-mono text-xs tracking-widest uppercase">Language</p>
      <ul class="mt-3 flex flex-col gap-1">
        <li class="text-text-secondary font-mono text-sm">TypeScript (strict)</li>
      </ul>
    </div>

    <div>
      <p class="text-text-tertiary font-mono text-xs tracking-widest uppercase">Frameworks</p>
      <ul class="mt-3 flex flex-col gap-1">
        <li class="text-text-secondary font-mono text-sm">React 19</li>
        <li class="text-text-secondary font-mono text-sm">React Router</li>
        <li class="text-text-secondary font-mono text-sm">TanStack Table</li>
        <li class="text-text-secondary font-mono text-sm">react-i18next</li>
        <li class="text-text-secondary font-mono text-sm">Recharts</li>
      </ul>
    </div>

    <div>
      <p class="text-text-tertiary font-mono text-xs tracking-widest uppercase">Styling</p>
      <ul class="mt-3 flex flex-col gap-1">
        <li class="text-text-secondary font-mono text-sm">Tailwind CSS</li>
      </ul>
    </div>

    <div>
      <p class="text-text-tertiary font-mono text-xs tracking-widest uppercase">Testing</p>
      <ul class="mt-3 flex flex-col gap-1">
        <li class="text-text-secondary font-mono text-sm">Vitest</li>
      </ul>
    </div>

    <div>
      <p class="text-text-tertiary font-mono text-xs tracking-widest uppercase">Data & APIs</p>
      <ul class="mt-3 flex flex-col gap-1">
        <li class="text-text-secondary font-mono text-sm">GraphQL/TheGraph</li>
        <li class="text-text-secondary font-mono text-sm">Firebase</li>
      </ul>
    </div>

    <div>
      <p class="text-text-tertiary font-mono text-xs tracking-widest uppercase">Tooling</p>
      <ul class="mt-3 flex flex-col gap-1">
        <li class="text-text-secondary font-mono text-sm">Vite</li>
        <li class="text-text-secondary font-mono text-sm">ESLint</li>
        <li class="text-text-secondary font-mono text-sm">Prettier</li>
      </ul>
    </div>

    <div>
      <p class="text-text-tertiary font-mono text-xs tracking-widest uppercase">Deploy</p>
      <ul class="mt-3 flex flex-col gap-1">
        <li class="text-text-secondary font-mono text-sm">Netlify</li>
      </ul>
    </div>

    <div>
      <p class="text-text-tertiary font-mono text-xs tracking-widest uppercase">Site</p>
      <ul class="mt-3 flex flex-col gap-1">
        <li class="text-text-secondary font-mono text-sm">Astro</li>
      </ul>
    </div>
  </div>
</Section>
