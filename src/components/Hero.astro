---
import ButtonLink from './ButtonLink.astro'
import Container from './Container.astro'
---

<section id="hero" class="relative flex min-h-screen flex-col justify-center">
  <Container>
    <div class="max-w-2xl">
      <span class="text-accent mb-4 block font-mono text-sm font-medium tracking-wide">
        Dalonso
      </span>

      <h1 class="text-text-primary mb-6 text-4xl leading-tight font-semibold sm:text-5xl">
        Frontend Engineer — React · TypeScript · Product Systems
      </h1>

      <p class="text-text-secondary mb-10 max-w-xl text-lg leading-relaxed">
        Some engineers need a product spec, a tech lead, and three standups a week to ship a
        feature. I'm not that engineer.
      </p>

      <div class="flex flex-wrap gap-4">
        <ButtonLink href="#projects" variant="primary">See my work </ButtonLink>
        <ButtonLink href="https://github.com/dalonsodev" variant="ghost">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
          <span>GitHub</span>
        </ButtonLink>
      </div>
    </div>
  </Container>
</section>
